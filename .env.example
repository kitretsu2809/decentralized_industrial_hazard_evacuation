# Redis
REDIS_URL=redis://redis:6379

# Simulation
SIM_STATE_FPS=10
SIM_SPEED=1.0

# GUI
GUI_PORT=8080

# Sensor anomaly model (generated by scripts/train_sensor_cnn.py)
SENSOR_CNN_CHECKPOINT=data/models/sensor_cnn.pt

# COCO person detector used by the recorded-video perception demonstration
YOLO_MODEL_PATH=data/models/yolo11n.pt
# CPU is the portable default. Use 0 only with a verified CUDA/torchvision build.
YOLO_DEVICE=cpu
# Colour-only fire detection can false-trigger on red machinery or overlays.
ENABLE_HSV_FIRE_FALLBACK=false

# GPU (optional)
GPU_MEMORY_LIMIT=4096

# Weights & Biases (optional, for training logging)
WANDB_PROJECT=lbp-evacuation
WANDB_API_KEY=

# Docker
COMPOSE_PROJECT_NAME=lbp
