# Redis
REDIS_URL=redis://redis:6379

# Simulation
SIM_STATE_FPS=10
SIM_SPEED=1.0

# GUI
GUI_PORT=8080

# Sensor anomaly model (generated by scripts/train_sensor_cnn.py)
SENSOR_CNN_CHECKPOINT=data/models/sensor_cnn.pt

# GPU (optional)
GPU_MEMORY_LIMIT=4096

# Weights & Biases (optional, for training logging)
WANDB_PROJECT=lbp-evacuation
WANDB_API_KEY=

# Docker
COMPOSE_PROJECT_NAME=lbp
